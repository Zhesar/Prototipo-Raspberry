# Función para cargar los UIDs permitidos desde un archivo de texto
def cargar_uids_permitidos():
    with open("permitidos.txt", "r") as file:
        return {line.strip() for line in file}

uids_permitidos = cargar_uids_permitidos()

# Audios de bienvenida y de repetición
audio_bienvenida = "/home/viat/Desktop/AUDIOS_VIAT/Bienvenida.wav"
audio_repeticion = "/home/viat/Desktop/AUDIOS_VIAT/repeticion_linea.wav"
audio_seleccion_20 = "/home/viat/Desktop/AUDIOS_VIAT/seleccion20.wav"
audio_repeticion_seleccion = "/home/viat/Desktop/AUDIOS_VIAT/repeticion_seleccion.wav"

# Controla si el audio está reproduciéndose
audio_reproduciendo = False
linea_confirmada = None  # Línea confirmada para reproducir el audio

# Añadir una variable global para asegurarse de que solo se reproduce una vez
detected_once = False

# Función de reproducción de audio optimizada
def reproducir_audio(ruta_audio):
    global audio_reproduciendo
    audio_reproduciendo = True
    print(f"Iniciando reproducción de: {ruta_audio}")

    try:
        with wave.open(ruta_audio, 'rb') as archivo:
            frecuencia_muestreo = archivo.getframerate()
            num_canales = archivo.getnchannels()
            num_muestras = archivo.getnframes()

            datos_audio = archivo.readframes(num_muestras)
            audio_array = np.frombuffer(datos_audio, dtype=np.int16)

            sd.play(audio_array, samplerate=frecuencia_muestreo, blocksize=1024, latency='low')
            sd.wait()  # Espera a que termine la reproducción

        print(f"Finalizando reproducción de: {ruta_audio}")
    except Exception as e:
        print(f"Error al reproducir el audio {ruta_audio}: {e}")
    finally:
        audio_reproduciendo = False

# Clase de la interfaz
class App(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.geometry("1680x1050")  # Aumentar tamaño de la ventana
        self.title("Detección de transporte")
        self.linea_actual = None
        self.nfc_activado = False
        self.temporizador_reset = None  # Añadimos el temporizador

        # Establecer el fondo blanco
        self.configure(bg='white')

        # Configurar la apariencia de CustomTkinter
        ctk.set_appearance_mode("light")  # Establece el modo claro

        # Label para la hora y el día
        self.hora_label = ctk.CTkLabel(self, text="", font=("Arial", 50), text_color='black')
        self.hora_label.pack(pady=50)

        # Label para la línea
        self.linea_label = ctk.CTkLabel(self, text="", font=("Arial", 350), text_color='black')
        self.linea_label.pack(pady=(50, 0))

        # Label para el subtítulo (con tamaño de fuente más pequeño)
        self.subtitulo_label = ctk.CTkLabel(self, text="", font=("Arial", 100), text_color='black')
        self.subtitulo_label.pack(pady=(0, 100))

        self.actualizar_hora()  # Inicia la actualización de la hora

    def mostrar_linea(self, nombre_linea):
        global linea_confirmada
        traducciones = {
            "línea uno": ("Línea 1", "Collico"),
            "línea dos": ("Línea 2", "Las Animas"),
            "línea tres": ("Línea 3", ""),
            "línea cuatro": ("Línea 4", ""),
            "línea cinco": ("Línea 5", "Corvi"),
            "línea nueve": ("Línea 9", ""),
            "línea once": ("Línea 11", "San pedro"),
            "línea veinte regional": ("Línea 20", "Regional"),
            "línea veinte niebla": ("Línea 20", "Niebla"),
            "línea veintidós": ("Línea 22", "")
        }
        texto_principal, texto_subtitulo = traducciones.get(nombre_linea, (nombre_linea, ""))
        self.linea_label.configure(text=texto_principal)
        self.subtitulo_label.configure(text=texto_subtitulo)
        linea_confirmada = nombre_linea  # Almacenar la línea confirmada

    def actualizar_hora(self):
         now = datetime.datetime.now()
         self.hora_label.configure(text=now.strftime("%Y-%m-%d %H:%M"))
         self.after(60000, self.actualizar_hora)  # Actualiza cada 60 segundos

    def limpiar_pantalla():
        self.linea_label.configure(text="")
        self.subtitulo_label.configure(text="")
        self.nfc_activado = False
        global linea_confirmada, detected_once
        linea_confirmada = None
        detected_once = False
        reproducir_audio("/home/viat/Desktop/AUDIOS_VIAT/gracias.wav")
        if self.temporizador_reset:
            self.after_cancel(self.temporizador_reset)  # Cancelar el temporizador si existía
        resetear_ciclo()  # Reiniciar el ciclo después de limpiar la pantalla

    def resetear_ciclo(self):
        global detected_once, linea_confirmada
        print("Reseteando ciclo por inactividad...")
        self.linea_label.configure(text="")
        self.subtitulo_label.configure(text="")
        self.nfc_activado = False
        linea_confirmada = None
        detected_once = False
        reproducir_audio("/home/viat/Desktop/AUDIOS_VIAT/gracias.wav")

    def activar_por_nfc(self):
        global detected_once
        detected_once = False  # Reiniciar la detección
        self.nfc_activado = True
        self.linea_label.configure(text="")
        self.subtitulo_label.configure(text="")
        reproducir_audio(audio_bienvenida)
        if self.temporizador_reset:
            self.after_cancel(self.temporizador_reset)  # Cancelar cualquier temporizador previo
        self.temporizador_reset = self.after(60000, self.resetear_ciclo)  # Iniciar el nuevo temporizador


# Ajustar la función de reconocimiento de voz
def callback(indata, frames, time, status):
    if status:
        print(status)
    if not audio_reproduciendo:  # Solo recibe audio si no se está reproduciendo
        q.put(bytes(indata))

# Función para manejar el reconocimiento de voz
def reconocer_voz():
    global app, detected_once
    with sd.RawInputStream(samplerate=16000, blocksize=3500, dtype='int16',
                           channels=1, callback=callback, device=2):
        rec = vosk.KaldiRecognizer(model, 16000)
        print("Diga algo...")

        while True:
            data = q.get()
            if rec.AcceptWaveform(data):
                result = json.loads(rec.Result())
                text = result.get("text", "")
                print("Texto detectado:", text)

                # diccionario palabras claves
                palabra_clave_a_audio = {
                    "visión artificial": "/home/viat/Desktop/AUDIOS_VIAT/VIAT.wav",
                    "proceso": "/home/viat/Desktop/AUDIOS_VIAT/proceso.wav",
                    "ayuda": "/home/viat/Desktop/AUDIOS_VIAT/ayuda.wav",
                    "paradero": "/home/viat/Desktop/AUDIOS_VIAT/paradero.wav",
                    "in formación": "/home/viat/Desktop/AUDIOS_VIAT/informacion.wav",
                    "recorrido línea uno": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea1.wav",
                    "recorrido micro uno": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea1.wav",
                    "recorrido línea dos": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea2.wav",
                    "recorrido micro dos": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea2.wav",
                    "recorrido línea tres": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea3.wav",
                    "recorrido micro tres": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea3.wav",
                    "recorrido línea cuatro": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea4.wav",
                    "recorrido micro cuatro": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea4.wav",
                    "recorrido línea cinco": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea5.wav",
                    "recorrido micro cinco": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea5.wav",
                    "recorrido línea nueve": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea9.wav",
                    "recorrido micro nueve": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea9.wav",
                    "recorrido línea once": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea11.wav",
                    "recorrido micro once": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea11.wav",
                    "recorrido línea veinte niebla": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea20niebla.wav",
                    "recorrido micro veinte niebla": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea20niebla.wav",
                    "recorrido línea veinte regional": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea20regional.wav",
                    "recorrido micro veinte regional": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea20regional.wav",
                    "recorrido línea veintidós": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea22.wav",
                    "recorrido micro veintidós": "/home/viat/Desktop/AUDIOS_VIAT/recorrido_linea22.wav"
                }

                # Detectar la palabra clave
                for palabra_clave, audio_path in palabra_clave_a_audio.items():
                    if palabra_clave in text and not audio_reproduciendo:
                        reproducir_audio(audio_path)
                        break  # Para evitar múltiples reproducciones

                if app.nfc_activado:  # Solo continúa si NFC está activado
                    if "línea veinte" in text or "micro veinte" in text and not audio_reproduciendo and not detected_once:
                        reproducir_audio(audio_seleccion_20)
                        confirmed = False
                        detected_once = True  # Marcar como detectado
                        if app.temporizador_reset:
                            app.after_cancel(app.temporizador_reset)  # Cancelar el temporizador anterior
                        app.temporizador_reset = app.after(60000, app.resetear_ciclo)  # Reiniciar el temporizador
                        while not confirmed:
                            data = q.get()
                            if rec.AcceptWaveform(data):
                                result = json.loads(rec.Result())
                                confirmacion = result.get("text", "")
                                print("Texto de confirmación:", confirmacion)
                                if "regional" in confirmacion and not audio_reproduciendo:
                                    reproducir_audio(audios_lineas["línea veinte regional"][1])
                                    app.mostrar_linea("línea veinte regional")
                                    confirmed = True
                                    detected_once = False  # Resetear bandera
                                    if app.temporizador_reset:
                                        app.after_cancel(app.temporizador_reset)  # Cancelar el temporizador si existía
                                    app.temporizador_reset = app.after(60000, app.resetear_ciclo)  # Reiniciar el temporizador   
                                elif "no" in confirmacion and not audio_reproduciendo:
                                    reproducir_audio(audio_repeticion)
                                    confirmed = True
                                    app.linea_label.configure(text="")
                                elif "niebla" in confirmacion and not audio_reproduciendo:
                                    reproducir_audio(audios_lineas["línea veinte niebla"][1])
                                    app.mostrar_linea("línea veinte niebla")
                                    confirmed = True
                                    detected_once = False  # Resetear bandera
                                    if app.temporizador_reset:
                                        app.after_cancel(app.temporizador_reset)  # Cancelar el temporizador si existía
                                    app.temporizador_reset = app.after(60000, app.resetear_ciclo)  # Reiniciar el temporizador
                                else:
                                    print("Confirmación no válida, repitiendo...")
                                    reproducir_audio(audio_repeticion_seleccion)
                                    confirmed = True
                    else:
                        linea_detectada = False
                        for linea, (ruta_audio, ruta_confirmacion) in audios_lineas.items():
                            if (linea in text or f"micro {linea.split()[1]}" in text) and not audio_reproduciendo and not detected_once:
                                linea_detectada = True
                                reproducir_audio(ruta_audio)
                                confirmed = False
                                detected_once = True  # Marcar como detectado

                                if app.temporizador_reset:
                                    app.after_cancel(app.temporizador_reset)  # Cancelar el temporizador anterior
                                app.temporizador_reset = app.after(60000, app.resetear_ciclo)  # Reiniciar el temporizador

                                while not confirmed:
                                    data = q.get()
                                    if rec.AcceptWaveform(data):
                                        result = json.loads(rec.Result())
                                        confirmacion = result.get("text", "")
                                        print("Texto de confirmación:", confirmacion)

                                        if "sí" in confirmacion and not audio_reproduciendo:
                                            reproducir_audio(ruta_confirmacion)
                                            app.mostrar_linea(linea)
                                            confirmed = True
                                            detected_once = False  # Resetear bandera
                                            if app.temporizador_reset:
                                                app.after_cancel(app.temporizador_reset)  # Cancelar el temporizador si existía
                                            app.temporizador_reset = app.after(60000, app.resetear_ciclo)  # Reiniciar el temporizador    
                                        elif "no" in confirmacion and not audio_reproduciendo:
                                            reproducir_audio(audio_repeticion)
                                            confirmed = True
                                            detected_once = False  # Resetear bandera

                        if ("línea" in text or "micro" in text) and not linea_detectada and not audio_reproduciendo:
                            reproducir_audio(audio_repeticion_seleccion)
# Hilo de lectura NFC
def leer_nfc():
    global app
    while True:
        uid = nfc.read_passive_target(timeout=0.5)
        if uid:
            uid_hex = ''.join([f"{i:02X}" for i in uid])
            print("Tarjeta NFC detectada con UID:", uid_hex)
            
            if uid_hex in uids_permitidos:
                print("Acceso permitido")
                app.activar_por_nfc()
            else:
                print("Acceso denegado")

# Crear un socket
def iniciar_socket():
    global linea_confirmada, detected_once
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server_socket:
        host = '0.0.0.0'
        port = 12345

        server_socket.bind((host, port))
        server_socket.listen(1)
        print(f"Escuchando en {host}:{port}...")

        client_socket, client_address = server_socket.accept()
        with client_socket:
            print(f"Conexión establecida con {client_address}")

            while True:
                try:
                    data = client_socket.recv(1024)
                    if not data:
                        break

                    message = data.decode().strip()
                    print(f"Recibido: {message}")

                    line_name = message.split(":")[1].strip() if ":" in message else message
                    if line_name == linea_confirmada and not detected_once:
                        detected_once = True
                        audio_file = audio_mapping.get(line_name)
                        if audio_file:
                            audio_path = os.path.join(audio_folder, audio_file)
                            if os.path.exists(audio_path):
                                print(f"Reproduciendo audio para {line_name}")
                                reproducir_audio(audio_path)
                                app.after(60000, app.limpiar_pantalla)  # Limpia la pantalla después de 10 segundos del aviso
                                app.after(60000, lambda: reproducir_audio("/home/viat/Desktop/AUDIOS_VIAT/gracias.wav"))  # Añadir aquí
                            else:
                                print(f"Archivo de audio no encontrado: {audio_path}")
                    else:
                        print(f"Línea no reconocida o no confirmada: {line_name}")

                except Exception as e:
                    print(f"Error al procesar mensaje: {e}")
                    break

        print("Conexión cerrada.")

# Iniciar hilos
hilo_reconocimiento = threading.Thread(target=reconocer_voz)
hilo_reconocimiento.start()

hilo_nfc = threading.Thread(target=leer_nfc)
hilo_nfc.start()

hilo_socket = threading.Thread(target=iniciar_socket)
hilo_socket.start()

# Iniciar la aplicación
app = App()
app.mainloop()
